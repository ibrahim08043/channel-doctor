{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "tsc --build",
    "dev:backend": "pnpm --filter @workspace/api-server run dev",
    "dev:frontend": "pnpm --filter @workspace/channel-doctor run dev"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "msw",
      "unrs-resolver",
      "@clerk/shared"
    ]
  }
}
