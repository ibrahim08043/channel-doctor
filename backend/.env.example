PORT=8080
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/
YOUTUBE_API_KEY=AIzaSyYOUR_GOOGLE_API_KEY
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE
# Groq API key (https://console.groq.com/keys). Required for all AI features.
GROQ_API_KEY=gsk_YOUR_GROQ_KEY
LOG_LEVEL=info
SESSION_SECRET=change-me-to-a-long-random-string
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE

# ── Real-time (Socket.IO) ──────────────────────────────────────────────────
# Enables the "AI quota low" system alert inside /api/notifications/scan.
# Set to "true" to surface a conservative quota warning when the scan runs.
GROQ_QUOTA_THRESHOLD=false

# Optional: raise or lower the Socket.IO heartbeat timing (defaults are fine).
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=20000
