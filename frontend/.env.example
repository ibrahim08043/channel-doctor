# ── Frontend env vars (Vite) ────────────────────────────────────────────────
# Values here are DEV defaults committed to the repo. Production values must be
# set in the Netlify UI → Site settings → Environment variables (both are
# prefixed VITE_ so they are inlined into the browser bundle at build time).

# Clerk publishable key. SAFE to expose in the browser.
# DEV:   pk_test_...   (as in frontend/.env)
# PROD:  pk_live_...   (replace the dev key in Netlify to clear the Clerk
#                      "development keys" warning and lift usage limits)
VITE_CLERK_PUBLISHABLE_KEY=

# Backend origin for ALL API traffic (REST + Socket.IO + YouTube OAuth).
# PROD:  set this to the deployed backend origin, e.g.
#        VITE_API_ORIGIN=https://your-backend.example.com
# If unset, the app falls back to the frontend's own origin. It NEVER uses
# localhost in production.
VITE_API_ORIGIN=
